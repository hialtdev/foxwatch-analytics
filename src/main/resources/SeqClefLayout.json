{
  "@t": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "@mt": {
    "$resolver": "message",
    "stringified": true
  },
  "@l": {
    "$resolver": "level",
    "field": "name"
  },
  "application": "foxwatch-analytics",
  "logger": {
    "$resolver": "logger",
    "field": "name"
  },
  "thread": {
    "$resolver": "thread",
    "field": "name"
  }
}